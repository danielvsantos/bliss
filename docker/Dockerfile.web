# ─── Stage 1: Build Vite app ─────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY apps/web ./apps/web

# Build arg so the API URL is baked into the static bundle
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Commit stamped into dist/version.json. There is no Node process at runtime —
# nginx serves static files — so the only way the web service can report which
# code is live is to bake it in here. Railway passes RAILWAY_GIT_COMMIT_SHA;
# GIT_COMMIT_SHA is the generic fallback. Unset simply yields "unknown".
ARG GIT_COMMIT_SHA=""
ARG RAILWAY_GIT_COMMIT_SHA=""
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA}
ENV RAILWAY_GIT_COMMIT_SHA=${RAILWAY_GIT_COMMIT_SHA}

WORKDIR /app/apps/web
# write-version.mjs runs first (see the package.json build script), emitting
# public/version.json for Vite to copy into dist/.
RUN pnpm run build

# ─── Stage 2: Serve with nginx ────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
