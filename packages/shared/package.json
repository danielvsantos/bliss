{
  "name": "@bliss/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./encryption": {
      "require": "./dist/encryption.cjs",
      "import": "./dist/encryption.js"
    },
    "./storage": {
      "require": "./dist/storage/index.cjs",
      "import": "./dist/storage/index.js"
    },
    "./sentry": {
      "require": "./dist/sentryScrub.cjs",
      "import": "./dist/sentryScrub.js"
    },
    "./portfolio": {
      "require": "./dist/portfolio/index.cjs",
      "import": "./dist/portfolio/index.js"
    },
    "./activity": {
      "require": "./dist/activity/index.cjs",
      "import": "./dist/activity/index.js"
    },
    "./enablebanking": {
      "require": "./dist/enablebanking/index.cjs",
      "import": "./dist/enablebanking/index.js"
    },
    "./etoro": {
      "require": "./dist/etoro/index.cjs",
      "import": "./dist/etoro/index.js"
    },
    "./bank-tx-label": {
      "require": "./dist/bankTxLabel.cjs",
      "import": "./dist/bankTxLabel.js"
    },
    "./import": {
      "require": "./dist/import/index.cjs",
      "import": "./dist/import/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/encryption.js src/storage/index.js src/sentryScrub.js src/portfolio/index.js src/activity/index.js src/enablebanking/index.js src/etoro/index.js src/bankTxLabel.js src/import/index.js --format esm,cjs --out-dir dist --no-splitting --external @google-cloud/storage",
    "dev": "tsup src/encryption.js src/storage/index.js src/sentryScrub.js src/portfolio/index.js src/activity/index.js src/enablebanking/index.js src/etoro/index.js src/bankTxLabel.js src/import/index.js --format esm,cjs --out-dir dist --no-splitting --external @google-cloud/storage --watch"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
