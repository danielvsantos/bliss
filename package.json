{
  "name": "bliss",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @bliss/api test",
    "test:backend": "pnpm --filter @bliss/backend test",
    "test:web": "pnpm --filter @bliss/web test",
    "dev:docs": "pnpm --filter @bliss/docs dev",
    "build:docs": "pnpm --filter @bliss/docs build",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "pnpm": {
    "//overrides": [
      "Security overrides. Each entry pins a transitive dependency that its own",
      "parent still resolves to a vulnerable version — the parent is pinned, so a",
      "version bump of the direct dependency cannot clear it. Remove an entry",
      "once the parent ships the patched range on its own.",
      "Audited by .github/workflows/security-audit.yml; anything here that is NOT",
      "overridable is listed with a justification in that workflow's allowlist."
    ],
    "overrides": {
      "protobufjs": "^8.4.1",
      "sharp": "^0.35.4",
      "postcss": "^8.5.28",
      "nanoid@3": "^3.3.18",
      "nanoid@5": "^5.1.16",
      "form-data@4": "^4.0.6",
      "ws@8": "^8.21.3",
      "tmp": "^0.2.7",
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "shell-quote": "^1.10.0",
      "fast-uri@3": "^3.1.6",
      "fast-xml-builder": "^1.1.7",
      "browserslist": "^4.28.7",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "@grpc/grpc-js": "^1.14.4",
      "@xmldom/xmldom": "^0.9.12",
      "form-data@2": "^2.5.6",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "defu": "^6.1.5",
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  }
}
